// Esquema físico del MVP (spec 01). Sin Claim ni PurchaseOrder (V2).
// Los CHECK, la secuencia order_number_seq y next_order_number() se declaran en la migración inicial.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING
  PROCESSING
  DISPATCHED
  DELIVERED
  CANCELLED

  @@map("order_status")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("users")
}

model Customer {
  id           Int      @id @default(autoincrement())
  businessName String   @map("business_name")
  taxId        String   @unique @map("tax_id")
  phone        String   @unique
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  orders       Order[]

  @@map("customers")
}

model Product {
  id            Int         @id @default(autoincrement())
  name          String
  description   String?
  price         Decimal     @db.Decimal(12, 2)
  currentStock  Int         @map("current_stock")
  minStockAlert Int         @map("min_stock_alert")
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  items         OrderItem[]

  @@index([isActive])
  @@map("products")
}

model Order {
  id          Int         @id @default(autoincrement())
  orderNumber String      @unique @default(dbgenerated("next_order_number()")) @map("order_number")
  customerId  Int         @map("customer_id")
  status      OrderStatus @default(PENDING)
  totalAmount Decimal     @map("total_amount") @db.Decimal(12, 2)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items       OrderItem[]

  @@index([customerId])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int      @map("order_id")
  productId Int      @map("product_id")
  quantity  Int
  unitPrice Decimal  @map("unit_price") @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([orderId, productId])
  @@index([productId])
  @@map("order_items")
}
