{
  "name": "medsupply-backend",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "jest",
    "test:db": "node --experimental-vm-modules --env-file-if-exists=../.env node_modules/jest/bin/jest.js --config jest.db.config.js --runInBand",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "PRISMA_HIDE_UPDATE_MESSAGE=1 node_modules/.bin/prisma generate",
    "db:migrate:deploy": "PRISMA_HIDE_UPDATE_MESSAGE=1 node_modules/.bin/prisma migrate deploy",
    "db:migrate:test": "node --env-file-if-exists=../.env -e \"let u;try{u=new URL(process.env.DATABASE_URL||'');u.pathname='/medsupply_test';if(decodeURIComponent(u.pathname.slice(1))!=='medsupply_test')throw 1}catch{console.error('db:migrate:test: DATABASE_URL ausente o inválida');process.exit(1)}const r=require('node:child_process').spawnSync('node_modules/.bin/prisma',['migrate','deploy'],{stdio:'inherit',env:{...process.env,DATABASE_URL:u.toString(),PRISMA_HIDE_UPDATE_MESSAGE:'1'}});process.exit(r.status??1)\""
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "express": "5.3.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.15.0",
    "jest": "30.5.2",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  },
  "overrides": {
    "effect": "3.22.5"
  }
}
