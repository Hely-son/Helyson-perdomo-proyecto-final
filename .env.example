# Puerto HTTP del backend. Opcional, 3000 por defecto. Entero de 1 a 65535.
PORT=3000

# Obligatoria. Esquema postgres:// o postgresql://. Solo se valida el formato.
# Uso en el host (desarrollo): sustituir APP_DB_USER y APP_DB_PASSWORD por los valores de abajo.
DATABASE_URL=postgresql://APP_DB_USER:APP_DB_PASSWORD@127.0.0.1:5432/medsupply

# Obligatoria. Al menos 32 bytes UTF-8. No commitear el valor real.
JWT_SECRET=

# Opcional, 8h por defecto. Formato: entero positivo seguido de s, m, h o d (p. ej. 30m, 8h, 1d).
JWT_EXPIRES_IN=8h

# Opcional, 30 por defecto. Entero positivo (minutos).
CHAT_SESSION_TTL_MINUTES=30

# PostgreSQL de Docker Compose. Todas obligatorias: Compose no arranca si falta alguna.
# Las dos contraseñas deben tener valores distintos (no se valida automáticamente).
# Superusuario de la imagen: solo lo recibe el servicio de base de datos.
POSTGRES_USER=
# Exclusivamente alfanumérica (A-Z, a-z, 0-9); otro carácter hace fallar la inicialización.
POSTGRES_PASSWORD=
# Usuario de aplicación (NOSUPERUSER, dueño de las bases): es el de DATABASE_URL.
# Solo letras minúsculas y dígitos (a-z, 0-9), y distinto de POSTGRES_USER (no se valida automáticamente).
APP_DB_USER=
# Exclusivamente alfanumérica (A-Z, a-z, 0-9); otro carácter hace fallar la inicialización.
APP_DB_PASSWORD=

# Operador inicial del seed (TK-00.4). Las tres son obligatorias para el seed y para la entrega.
# SEED_OPERATOR_EMAIL: formato email. SEED_OPERATOR_NAME: no vacío.
# SEED_OPERATOR_PASSWORD: sin política de complejidad, pero se recomienda una contraseña robusta.
# No commitear nunca valores reales.
# Si el operador (mismo email) ya existe, el seed conserva sus datos y NO rota su contraseña aunque cambie
# SEED_OPERATOR_PASSWORD: cambiarla requiere un procedimiento explícito posterior.
SEED_OPERATOR_EMAIL=
SEED_OPERATOR_PASSWORD=
SEED_OPERATOR_NAME=

# Frontend. URL base del API usada por el frontend; opcional, /api/v1 por defecto.
# En desarrollo debe ser una ruta relativa: el proxy de Vite la reenvía a localhost:3000.
# Una URL externa (otro origen) requeriría CORS, que no está configurado.
# Las variables VITE_* se incrustan en el bundle del navegador: nunca poner secretos.
VITE_API_BASE_URL=/api/v1
